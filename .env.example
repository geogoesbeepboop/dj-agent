# Copy to .env and fill in. .env is gitignored. NEVER put real secrets here.

# --- Models (agent-core substrate; Architect/Selector use Claude Agent SDK) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Vibe vector DB (Supabase / Postgres + pgvector) ---
# Empty = DB ops are skipped (unit tests still run). Fill in to ingest a library.
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Audio / output ---
DJ_SAMPLE_RATE=22050           # librosa DSP (BPM/key/energy)
DJ_CLAP_SAMPLE_RATE=48000      # CLAP's required input rate
DJ_OUTPUT_DIR=./renders

# --- Vibe embedding (CLAP learned audio+text embeddings) ---
CLAP_MODEL=laion/larger_clap_music

# --- HITL: approve the set before rendering ---
HITL_LEVEL=full

# --- Tracing (optional; no-ops if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Programmatic sources (Phase 1+; CC-licensed, e.g. Jamendo) ---
JAMENDO_CLIENT_ID=
