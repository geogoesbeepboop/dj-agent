# Copy to .env and fill in. .env is gitignored. NEVER put real secrets here.

# --- Models (agent-core substrate; Architect/Selector call agent-core complete()) ---
# Only needed for LIVE set generation. `--offline` runs the deterministic arc +
# greedy selector with no API key, and ingestion/tagging never call the LLM.
ANTHROPIC_API_KEY=sk-ant-...

# --- Vibe vector DB (Supabase / Postgres + pgvector) ---
# Empty = DB ops are skipped (unit tests still run). Fill in to ingest a library.
# The `vector` extension must be enabled (Supabase: Database → Extensions, or the
# Curator runs `CREATE EXTENSION IF NOT EXISTS vector` on first ingest).
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Audio / output ---
DJ_SAMPLE_RATE=22050           # librosa DSP (BPM/key/energy)
DJ_CLAP_SAMPLE_RATE=48000      # CLAP's required input rate
DJ_OUTPUT_DIR=./renders

# --- Vibe embedding (CLAP learned audio+text embeddings) ---
CLAP_MODEL=laion/larger_clap_music

# --- Personal taste layer (ADR 0003) ---
TASTE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Blend for ranking: score = α·acoustic + β·taste + γ·(rating/5). Lean acoustic
# while taste labels are sparse; raise β as labels accumulate.
DJ_W_ACOUSTIC=0.5
DJ_W_TASTE=0.4
DJ_W_RATING=0.1

# --- HITL: approve the set before rendering ('full' | 'none') ---
HITL_LEVEL=full

# --- Tracing (optional; no-ops if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
